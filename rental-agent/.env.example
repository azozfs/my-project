# --- Claude ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low = أسرع وأرخص وكافي للمحادثات. ارفعه لـ medium إذا لاحظت ردود ضعيفة.
AGENT_EFFORT=low

# --- WhatsApp Cloud API (من developers.facebook.com → تطبيقك → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# كلمة سر تختارها أنت وتكتبها نفسها في إعدادات الـ Webhook عند Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret من إعدادات التطبيق → Basic (يتأكد إن الرسائل جاية من Meta فعلًا)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- لوحة الموظفين: افتح /admin?token=<هذي القيمة> ---
ADMIN_TOKEN=

# --- اختياري ---
# DB_PATH=data/agent.db
# UNITS_PATH=data/units.json
# SESSION_GAP_HOURS=24
